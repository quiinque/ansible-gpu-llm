services:
  ollama:
    image: {{ ollama_image | to_json }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ ollama_port }}:11434"
    volumes:
      - models:/root/.ollama
    environment:
      OLLAMA_HOST: "0.0.0.0:11434"
      OLLAMA_CONTEXT_LENGTH: "{{ ollama_context_length }}"
      OLLAMA_KEEP_ALIVE: {{ ollama_keep_alive | to_json }}
      OLLAMA_NUM_PARALLEL: "1"
      OLLAMA_MAX_LOADED_MODELS: "1"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
volumes:
  models:
